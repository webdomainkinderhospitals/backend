# --- Database (Neon today, GCP Cloud SQL later — just swap this URL) ---
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.aws.neon.tech/kinderdb?sslmode=require"

# --- Auth ---
JWT_SECRET="change-this-to-a-long-random-string"
ADMIN_EMAIL="admin@kinderhospitals.com"
ADMIN_PASSWORD="ChangeMe123!"

# --- CORS: your Vercel frontend + admin URLs (comma separated) ---
CORS_ORIGINS="https://www.kinderhospitals.com,https://admin.kinderhospitals.com,http://localhost:3000,http://localhost:5173"

# --- Images: Google Cloud Storage bucket (leave empty for local dev uploads) ---
GCS_BUCKET=""
# Optional custom CDN/domain for images, e.g. https://images.kinderhospitals.com
GCS_PUBLIC_BASE=""

# --- Server ---
PORT=8080
PUBLIC_URL="http://localhost:8080"
